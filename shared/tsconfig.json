{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "zod": ["../frontend/node_modules/zod"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "types/**/*.ts",
    "validators/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["node"],
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      "@shared/*": ["./_shared/*"],
      "*": ["../../frontend/node_modules/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../../shared/**/*.ts"
  ]
}
